# Frontier Scout credentials. Copy to .env and fill in. NEVER commit .env.
#
# The four core connectors (Substack, Hacker News, arXiv, primary blogs) need
# NO credentials and run without anything in this file.

# Required for the LLM layer (scouts, clustering, evaluation).
ANTHROPIC_API_KEY=

# Optional. Enables the YouTube coverage connector.
# Free to obtain. NOTE: search.list is capped at 100 calls/day, separate from
# the 10,000-unit pool, so coverage checks run only after the momentum gate.
YOUTUBE_API_KEY=

# Optional. The X connector is OFF BY DEFAULT (see config/editorial.yaml).
# X has no free tier: reads are billed per returned resource (~$0.005/post),
# so enabling this spends real money. The budget governor in
# frontier_scout/ingest/x_api.py enforces the ceilings in config/editorial.yaml.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# Optional. Google Trends API is alpha and application-gated; without access
# the public-interest signal reports NOT_AVAILABLE rather than being faked.
GOOGLE_TRENDS_API_KEY=
